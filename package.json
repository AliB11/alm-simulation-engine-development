{
  "name": "alm-simulation-engine",
  "private": true,
  "version": "1.0.0",
  "description": "موتور شبیه‌سازی مدیریت دارایی و بدهی (ALM) — طراح پله‌های تسهیلاتی امتیازی و شبیه‌ساز ریسک نقدینگی بر پایهٔ ماتریس جریان وجوه نقد ویژه‌محور",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.47.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "2.3.0"
  }
}
